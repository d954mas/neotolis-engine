{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "description": "Neutral toolchain-independent settings only. No build type, no dev tooling: those belong to the concrete *-debug / *-release presets.",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_C_STANDARD": "17",
                "CMAKE_C_STANDARD_REQUIRED": "ON"
            }
        },
        {
            "name": "base-wasm",
            "hidden": true,
            "description": "Emscripten toolchain on top of base. Games may inherit this for a policy-free starting point.",
            "inherits": "base",
            "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake"
        },
        {
            "name": "base-native",
            "hidden": true,
            "description": "clang + compile_commands.json on top of base. Games may inherit this for a policy-free starting point.",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "wasm-debug",
            "displayName": "WASM Debug (dev tools ON)",
            "inherits": "base-wasm",
            "binaryDir": "${sourceDir}/build/_cmake/wasm-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "NT_UI_DEBUG_TOOLS": "ON"
            }
        },
        {
            "name": "wasm-release",
            "displayName": "WASM Release (dev tools OFF)",
            "inherits": "base-wasm",
            "binaryDir": "${sourceDir}/build/_cmake/wasm-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "NT_UI_DEBUG_TOOLS": "OFF"
            }
        },
        {
            "name": "wasm-debug-paired",
            "displayName": "WASM Debug Paired",
            "inherits": "wasm-debug",
            "binaryDir": "${sourceDir}/build/_cmake/wasm-debug-paired",
            "cacheVariables": {
                "NT_WASM_SIMD_WASM_PATH": "index_simd.wasm"
            }
        },
        {
            "name": "wasm-release-paired",
            "displayName": "WASM Release Paired",
            "inherits": "wasm-release",
            "binaryDir": "${sourceDir}/build/_cmake/wasm-release-paired",
            "cacheVariables": {
                "NT_WASM_SIMD_WASM_PATH": "index_simd.wasm"
            }
        },
        {
            "name": "wasm-debug-simd",
            "displayName": "WASM Debug SIMD",
            "inherits": "wasm-debug",
            "binaryDir": "${sourceDir}/build/_cmake/wasm-debug-simd",
            "cacheVariables": {
                "NT_WASM_ENABLE_SIMD": "ON"
            }
        },
        {
            "name": "wasm-release-simd",
            "displayName": "WASM Release SIMD",
            "inherits": "wasm-release",
            "binaryDir": "${sourceDir}/build/_cmake/wasm-release-simd",
            "cacheVariables": {
                "NT_WASM_ENABLE_SIMD": "ON"
            }
        },
        {
            "name": "native-debug",
            "displayName": "Native Debug (dev tools ON)",
            "inherits": "base-native",
            "binaryDir": "${sourceDir}/build/_cmake/native-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "NT_UI_DEBUG_TOOLS": "ON"
            }
        },
        {
            "name": "native-release",
            "displayName": "Native Release (dev tools OFF)",
            "inherits": "base-native",
            "binaryDir": "${sourceDir}/build/_cmake/native-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "NT_UI_DEBUG_TOOLS": "OFF"
            }
        },
        {
            "name": "native-debug-test",
            "displayName": "Native Debug Test (FULL asserts)",
            "inherits": "native-debug",
            "binaryDir": "${sourceDir}/build/_cmake/native-debug-test",
            "cacheVariables": {
                "NT_ASSERT_MODE": "2"
            }
        },
        {
            "name": "native-release-test",
            "displayName": "Native Release Test (FULL asserts, dev tools ON)",
            "description": "Coverage preset, not a shipping mirror: dev tools are re-enabled so their tests run under release optimizations.",
            "inherits": "native-release",
            "binaryDir": "${sourceDir}/build/_cmake/native-release-test",
            "cacheVariables": {
                "NT_ASSERT_MODE": "2",
                "NT_UI_DEBUG_TOOLS": "ON"
            }
        },
        {
            "name": "wasm-analysis",
            "displayName": "WASM Analysis",
            "inherits": "wasm-release",
            "binaryDir": "${sourceDir}/build/_cmake/wasm-analysis",
            "cacheVariables": {
                "NT_WASM_ANALYSIS": "ON"
            }
        },
        {
            "name": "wasm-analysis-paired",
            "displayName": "WASM Analysis Paired",
            "inherits": "wasm-analysis",
            "binaryDir": "${sourceDir}/build/_cmake/wasm-analysis-paired",
            "cacheVariables": {
                "NT_WASM_SIMD_WASM_PATH": "index_simd.wasm"
            }
        },
        {
            "name": "wasm-analysis-simd",
            "displayName": "WASM Analysis SIMD",
            "inherits": "wasm-analysis",
            "binaryDir": "${sourceDir}/build/_cmake/wasm-analysis-simd",
            "cacheVariables": {
                "NT_WASM_ENABLE_SIMD": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "wasm-debug",
            "configurePreset": "wasm-debug"
        },
        {
            "name": "wasm-release",
            "configurePreset": "wasm-release"
        },
        {
            "name": "wasm-debug-paired",
            "configurePreset": "wasm-debug-paired"
        },
        {
            "name": "wasm-release-paired",
            "configurePreset": "wasm-release-paired"
        },
        {
            "name": "wasm-debug-simd",
            "configurePreset": "wasm-debug-simd"
        },
        {
            "name": "wasm-release-simd",
            "configurePreset": "wasm-release-simd"
        },
        {
            "name": "native-debug",
            "configurePreset": "native-debug"
        },
        {
            "name": "native-release",
            "configurePreset": "native-release"
        },
        {
            "name": "native-debug-test",
            "configurePreset": "native-debug-test"
        },
        {
            "name": "native-release-test",
            "configurePreset": "native-release-test"
        },
        {
            "name": "wasm-analysis",
            "configurePreset": "wasm-analysis"
        },
        {
            "name": "wasm-analysis-paired",
            "configurePreset": "wasm-analysis-paired"
        },
        {
            "name": "wasm-analysis-simd",
            "configurePreset": "wasm-analysis-simd"
        }
    ],
    "testPresets": [
        {
            "name": "wasm-debug",
            "configurePreset": "wasm-debug",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "wasm-debug-paired",
            "configurePreset": "wasm-debug-paired",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "wasm-debug-simd",
            "configurePreset": "wasm-debug-simd",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "wasm-release",
            "configurePreset": "wasm-release",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "wasm-release-paired",
            "configurePreset": "wasm-release-paired",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "wasm-release-simd",
            "configurePreset": "wasm-release-simd",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "wasm-analysis",
            "configurePreset": "wasm-analysis",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "wasm-analysis-paired",
            "configurePreset": "wasm-analysis-paired",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "wasm-analysis-simd",
            "configurePreset": "wasm-analysis-simd",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "native-debug",
            "configurePreset": "native-debug",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "native-debug-test",
            "configurePreset": "native-debug-test",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "native-release-test",
            "configurePreset": "native-release-test",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
