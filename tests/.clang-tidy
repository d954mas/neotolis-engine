# Tests only: Unity assert macros expand to branches, so any substantive test
# trips the default cognitive-complexity threshold (25) without being complex.
# Unity test functions and the web probes exported to JS keep external linkage.
InheritParentConfig: true
Checks: '-misc-use-internal-linkage'
CheckOptions:
  - key: readability-function-cognitive-complexity.Threshold
    value: '40'
